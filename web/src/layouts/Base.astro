---
import { Font } from "astro:assets";
import { Logo } from "../components/Logo/Logo";
import { MainMenu } from "../components/MainMenu/MainMenu";
import { MenuDrawer } from "../components/MainMenu/MenuDrawer";
import { pageTitle } from "../lib/page-title";
import "../styles/tokens.css";

type Props = {
  title?: string;
  /** The robots meta tag, e.g. `noindex` for preview pages. */
  robots?: string;
};

const { title, robots } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle(title)}</title>
    {robots && <meta name="robots" content={robots} />}
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-text" preload />
  </head>
  <body>
    <a class="skip" href="#main" data-surface="white">
      Zum Inhalt springen
    </a>
    <header class="wrap">
      <Logo />
      <MainMenu current={Astro.url.pathname}>
        {/* Hydrates on phones only; desktop loads none of its JavaScript. The query matches MainMenu.css. */}
        <MenuDrawer
          client:media="(width < 66em)"
          current={Astro.url.pathname}
        />
      </MainMenu>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer data-surface="ink">
      <div class="wrap">
        <p>
          <a href="https://www.instagram.com/bewegdichdarmstadt/">
            Instagram @bewegdichdarmstadt
          </a>
        </p>
        <nav aria-label="Rechtliches">
          <ul role="list">
            <li>
              <a href="/impressum">Impressum</a>
            </li>
            <li>
              <a href="/datenschutz">Datenschutz</a>
            </li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>

<script>
  import "../components/MainMenu/main-menu";
</script>

<style>
  /* The footer sits at the window's bottom edge on short pages. Percent heights, not vh/svh/dvh, which
     mobile browsers resolve inconsistently. */
  html {
    height: 100%;
    /* Keeps focused elements and anchor targets clear of the fixed menu. */
    scroll-padding-block: var(--menu-room-top) var(--menu-room-bottom);
  }
  body {
    min-height: 100%;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
  }

  .wrap {
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin-inline: auto;
  }

  /* Off-screen until the first Tab lands on it. */
  .skip {
    position: absolute;
    top: var(--space-3);
    left: var(--gutter);
    /* Above the header, which lies over a hero. */
    z-index: 2;
    padding: var(--space-2) var(--space-4);
    font-weight: 700;
    color: var(--fg);
    border: var(--border) solid var(--line);
    box-shadow: var(--shadow-sm) var(--line);
    transform: translateY(calc(-100% - var(--space-5)));
  }
  .skip:focus {
    transform: none;
  }

  /* The logo stays in normal flow; the row is as tall as the fixed menu card or the logo's one line,
     so the two line up. */
  :root {
    --header-height: calc(
      max(var(--menu-row), 1.05 * var(--step-1)) + 2 * var(--space-5)
    );
  }
  header {
    display: flex;
    align-items: center;
    min-height: var(--header-height);
    padding-block: var(--space-5);
  }

  /* A hero paints from the window's top edge, so the header lies over it with no background of its
     own; the hero pads its content by --header-room. Without :has() the header stays in flow. */
  body:has(.hero) {
    --header-room: var(--header-height);
  }
  body:has(.hero) header {
    position: absolute;
    inset-inline: 0;
    z-index: 1;
    height: var(--header-height);
  }

  /* On phones the footer runs on under the bottom bar, so the bar never covers its links. */
  footer {
    padding-block: var(--space-6) calc(var(--space-6) + var(--menu-room-bottom));
  }
  footer .wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
  }
  footer p {
    margin: 0;
  }
  footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  footer a {
    color: inherit;
  }
</style>
