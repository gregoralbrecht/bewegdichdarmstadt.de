---
import { Button } from "../components/Button/Button";
import { Cluster } from "../components/Cluster/Cluster";
import { CtaBand } from "../components/CtaBand/CtaBand";
import { FactList } from "../components/FactList/FactList";
import { Heading } from "../components/Heading/Heading";
import { Hero } from "../components/Hero/Hero";
import { Lead } from "../components/Lead/Lead";
import { Prose } from "../components/Prose/Prose";
import { Section } from "../components/Section/Section";
import Base from "../layouts/Base.astro";

// Bare HTML for now: each change in docs/landing-page-plan.md swaps its part for a component.
---

<Base>
  <Hero
    title="Beweg dich, Darmstadt!"
    href="https://www.instagram.com/bewegdichdarmstadt/"
  >
    <Fragment slot="lead">
      Wir gehen gemeinsam auf die Straße: laufend, mit dem Rad oder tanzend, mit
      Musik, durch Darmstadt. Kostenlos und für alle.
    </Fragment>
    <p>
      Gerade ist Winterpause. Auf Instagram erfährst du, wann es weitergeht.
    </p>
    {/* One string, so formatting can't put spaces between the <wbr> parts. */}
    <Fragment
      slot="action"
      set:html="Folge @beweg<wbr />dich<wbr />darmstadt"
    />
  </Hero>

  <Section surface="cream" aria-labelledby="termine">
    <Prose>
      <Heading level={2} id="termine">
        Termine
      </Heading>
      <ul>
        <li>
          <article>
            <Heading level={3}>
              <a href="/run-and-rave">Run &amp; Rave</a>
            </Heading>
            <p>Winterpause</p>
            <p>Die Runden für 2026 sind gelaufen. Neue Termine folgen 2027.</p>
          </article>
        </li>
        <li>
          <article>
            <Heading level={3}>
              <a href="/festival">Festival 2027</a>
            </Heading>
            <p>Save the Date</p>
            <p>
              Samstag, 11. September 2027, 14 bis 18 Uhr, bei Menschenskinder in
              Darmstadt-Kranichstein.
            </p>
          </article>
        </li>
      </ul>
    </Prose>
  </Section>

  <Section surface="orange" aria-labelledby="fuer-alle">
    <Prose>
      <Heading level={2} id="fuer-alle">
        Du musst nicht schnell sein. Du musst nicht mal laufen.
      </Heading>
      <Lead>
        Beim Run &amp; Rave laufen und fahren wir rund 5,5 km mit Musik, in
        entspanntem Tempo von etwa 7:30 Minuten pro Kilometer.
      </Lead>
      <FactList
        items={[
          { term: "Treffpunkt", detail: "Friedensplatz" },
          { term: "Mit dem Rad dabei sein", detail: "geht" },
          { term: "Unterwegs abkürzen", detail: "geht" },
          { term: "Teilnahme", detail: "kostenlos" },
          { term: "Demo", detail: "angemeldet, mit Polizeibegleitung" },
        ]}
      />
    </Prose>
  </Section>

  <Section surface="night" aria-labelledby="bisher">
    <Prose>
      <Heading level={2} id="bisher">
        Bisher
      </Heading>
      <p id="run-and-rave-2026">Run &amp; Rave 2026</p>
      <Cluster as="ul" aria-labelledby="run-and-rave-2026">
        <li>10. Juli</li>
        <li>20. August</li>
        <li>24. September</li>
        <li>30. Oktober</li>
      </Cluster>
      <p>Festival 2025 auf dem Friedensplatz</p>
    </Prose>
  </Section>

  <Section surface="cream" aria-labelledby="wer-wir-sind">
    <Prose>
      <Heading level={2} id="wer-wir-sind">
        Wer wir sind
      </Heading>
      <p>
        Hinter <em>Beweg dich, Darmstadt</em> stehen zwei selbstständige Frauen
        aus Darmstadt: Steffi und Lea.
      </p>
      <ul>
        <li>
          <article>
            <Heading level={3}>Steffi Rieger</Heading>
            <p>Foto folgt</p>
            <p>Yogalehrerin, Unternehmerin und Life &amp; Team Coach</p>
          </article>
        </li>
        <li>
          <article>
            <Heading level={3}>Lea Emmel</Heading>
            <p>Foto folgt</p>
            <p>
              Gründerin von Outdoor Training Darmstadt und zertifizierte
              Trainerin
            </p>
          </article>
        </li>
      </ul>
      <p class="actions">
        <Button href="/ueber-uns">Mehr über uns</Button>
      </p>
    </Prose>
  </Section>

  <CtaBand id="spenden" title="Kostenlos für alle." href="#spenden">
    <p>Spenden helfen, die laufenden Kosten zu decken.</p>
    <p>Platzhalter: PayPal-Link folgt</p>
    <Fragment slot="action">Jetzt spenden</Fragment>
  </CtaBand>
</Base>

<style>
  /* Room for the hard shadows and the hero's layers, as on /gestaltung. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5) var(--space-6);
    padding-block: var(--space-2) var(--space-4);
  }
</style>
