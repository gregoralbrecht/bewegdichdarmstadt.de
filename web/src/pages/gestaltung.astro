---
import { Button } from "../components/Button/Button";
import { Card, CardLink } from "../components/Card/Card";
import { Heading } from "../components/Heading/Heading";
import { Lead } from "../components/Lead/Lead";
import { Prose } from "../components/Prose/Prose";
import { Section } from "../components/Section/Section";
import { Tag } from "../components/Tag/Tag";
import Base from "../layouts/Base.astro";
import { contrastRatio, hexTokens, surfaceTokens } from "../lib/contrast";
import { primitives, surfaces, tagNames, type Surface } from "../lib/palette";
import tokensCss from "../styles/tokens.css?raw";

// Preview of the surface system for the palette meeting with the client; not for search engines.
const hex = hexTokens(tokensCss);
const roles = surfaceTokens(tokensCss, hex);
const ratio = new Intl.NumberFormat("de", {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
});
const contrast = (surface: Surface, role: string) => {
  const r = roles.get(surface)!;
  return ratio.format(contrastRatio(r.get(role)!, r.get("bg")!));
};
// Every primitive and tag color against ink, the text they carry.
const withInk = (token: string) =>
  ratio.format(contrastRatio(hex.get("ink")!, hex.get(token)!));

const names: Record<Surface, string> = {
  cream: "Creme",
  white: "Weiß",
  night: "Nacht",
  ink: "Tinte",
  orange: "Orange",
  pink: "Pink",
  violet: "Violett",
};

const slots = [
  { time: "14:00", title: "Yoga im Park", kind: "Ruhe", fill: "mint" },
  { time: "15:30", title: "Tanz-Workshop", kind: "Tanz", fill: "peach" },
  { time: "17:00", title: "Staffellauf", kind: "Laufen", fill: "lime" },
] as const;

const shadows = ["shadow-sm", "shadow", "shadow-lg"];
const steps = ["step-4", "step-3", "step-2", "step-1", "step-0", "step--1"];
const spaces = [1, 2, 3, 4, 5, 6, 7, 8].map((n) => `space-${n}`);
const sample = "„Lauf mit!“ – Größe, Mühe, Spaß: Äpfel, Öfen, Übermut.";
---

<Base title="Gestaltung" robots="noindex">
  <Section surface="night" aria-labelledby="gestaltung">
    <Prose>
      <Heading level={1} id="gestaltung">
        Gestaltung
      </Heading>
      <Lead>
        Jede Fläche setzt ihre Farben einmal, und alles darin folgt: Text,
        Links, Buttons, Karten und Schatten. Die Werte sind Platzhalter, bis die
        Palette steht.
      </Lead>
      <p class="actions">
        <Button variant="hero" href="#flaechen">
          Alle Flächen der Reihe nach ansehen
        </Button>
      </p>
    </Prose>
  </Section>

  <div id="flaechen">
    {surfaces.map((surface) => (
      <Section surface={surface} aria-labelledby={`flaeche-${surface}`}>
        <div class="split">
          <Prose>
            <Heading level={2} id={`flaeche-${surface}`}>
              {names[surface]}
            </Heading>
            <p>
              Fließtext auf <code>data-surface="{surface}"</code>. Hier steht,
              worum es geht, mit einem <a href="#flaechen">Link im Text</a>.
            </p>
            <p class="muted">
              Kontrast: Text {contrast(surface, "fg")}, Nebentext{" "}
              {contrast(surface, "muted")}, Link {contrast(surface, "link")},
              Fokus {contrast(surface, "focus")}
            </p>
            <p class="actions">
              <Button href="#flaechen">Mitmachen</Button>
              <Button variant="secondary" href="#flaechen">
                Mehr erfahren
              </Button>
            </p>
          </Prose>
          <Card>
            <Heading level={3}>Run &amp; Rave</Heading>
            <p>
              <time datetime="2026-10-30T19:00">
                Freitag, 30. Oktober, 19 Uhr
              </time>
            </p>
            <p>
              Fünf Kilometer durch die Stadt, danach Musik.{" "}
              <a href="#flaechen">Details</a>
            </p>
          </Card>
        </div>
      </Section>
    ))}
  </div>

  <Section surface="cream" aria-labelledby="farben">
    <Prose>
      <Heading level={2} id="farben">
        Farben
      </Heading>
      <ul class="grid" role="list">
        {primitives.map(({ token, role, wip }) => (
          <li class="swatch">
            <div
              class="chip"
              style={`background: var(--${token})`}
              aria-hidden="true"
            />
            <Heading level={3} size="1">
              <code>--{token}</code>
            </Heading>
            <p>
              <code>{hex.get(token)}</code> · {role}
              {wip && " (WIP)"}
            </p>
            <p class="pair">Kontrast mit ink: {withInk(token)}</p>
          </li>
        ))}
      </ul>
    </Prose>
  </Section>

  <Section surface="cream" aria-labelledby="schatten">
    <Prose>
      <Heading level={2} id="schatten">
        Schatten und Rahmen
      </Heading>
      <ul class="grid" role="list">
        {shadows.map((token) => (
          <li class="box" style={`box-shadow: var(--${token}) var(--line)`}>
            <code>--{token}</code>
          </li>
        ))}
        <li class="box">
          <code>--border</code>
        </li>
        <li class="box thin">
          <code>--border-thin</code>
        </li>
        <li class="box pill">
          <code>--radius-tag</code>
        </li>
      </ul>
    </Prose>
  </Section>

  <Section surface="cream" aria-labelledby="schriften">
    <Prose>
      <Heading level={2} id="schriften">
        Schriften
      </Heading>
      <p class="font-sample display">
        <span class="label">
          Bricolage Grotesque, <code>--font-display</code>
        </span>
        {sample}
      </p>
      <p class="font-sample">
        <span class="label">
          Figtree, <code>--font-text</code>
        </span>
        {sample}
      </p>
    </Prose>
  </Section>

  <Section surface="cream" aria-labelledby="typo">
    <Prose>
      <Heading level={2} id="typo">
        Schriftgrößen
      </Heading>
      <ul class="stack" role="list">
        {steps.map((token) => (
          <li>
            <span class="label">
              <code>--{token}</code>
            </span>
            <span class="step" style={`font-size: var(--${token})`}>
              Beweg dich
            </span>
          </li>
        ))}
      </ul>
    </Prose>
  </Section>

  <Section surface="cream" aria-labelledby="abstaende">
    <Prose>
      <Heading level={2} id="abstaende">
        Abstände
      </Heading>
      <ul class="stack" role="list">
        {spaces.map((token) => (
          <li class="space">
            <code>--{token}</code>
            <span
              class="bar"
              style={`width: var(--${token})`}
              aria-hidden="true"
            />
          </li>
        ))}
      </ul>
    </Prose>
  </Section>

  <Section surface="cream" aria-labelledby="sticker">
    <Prose>
      <Heading level={2} id="sticker">
        Sticker-Karte
      </Heading>
      <Card tilt={-2}>
        <Heading level={3} size="1">
          <CardLink href="#sticker">Run &amp; Rave</CardLink>
        </Heading>
        <p>
          <time datetime="2026-10-30T19:00">Freitag, 30. Oktober, 19 Uhr</time>
        </p>
        <p>Fünf Kilometer durch die Stadt, danach Musik. Drück mich.</p>
      </Card>
    </Prose>
  </Section>

  <Section surface="cream" aria-labelledby="festival">
    <Prose>
      <Heading level={2} id="festival">
        Festival-Programm
      </Heading>
      <p>
        Farbige Karten nur, wenn die Farbe etwas bedeutet: hier die Art des
        Programmpunkts, immer auch als Wort.
      </p>
      <ul class="slots" role="list">
        {slots.map(({ time, title, kind, fill }) => (
          <li>
            <Card fill={fill}>
              <p class="time">
                <time datetime={`2027-06-12T${time}`}>{time}</time>
              </p>
              <Heading level={3}>{title}</Heading>
              <Tag color={fill}>{kind}</Tag>
              <p class="card-actions">
                <Button size="small" href="#festival">
                  Kalender
                </Button>
              </p>
            </Card>
          </li>
        ))}
      </ul>
    </Prose>
  </Section>

  <Section surface="cream" aria-labelledby="tags-titel" id="tags">
    <Prose>
      <Heading level={2} id="tags-titel">
        Tag-Palette (WIP)
      </Heading>
      <p>
        Noch offen: Die Farben werden mit euch festgelegt. Nur für Tags und
        Kartenfüllungen, immer mit dunkler Schrift.
      </p>
      <ul class="tags" role="list">
        {tagNames.map((color) => (
          <li>
            <Tag color={color}>{color}</Tag>
            <p>
              <code>{hex.get(`tag-${color}`)}</code> · Kontrast mit ink:{" "}
              {withInk(`tag-${color}`)}
            </p>
          </li>
        ))}
      </ul>
    </Prose>
  </Section>
</Base>

<style>
  .muted {
    color: var(--muted);
    font-size: var(--step--1);
  }
  /* Room for the hard shadows and the hero's layers. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5) var(--space-6);
    padding-block: var(--space-2) var(--space-4);
  }
  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: start;
    gap: var(--space-6);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .slots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-6) var(--space-5);
  }
  .slots :global(.card) {
    height: 100%;
  }
  .time {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-2);
    margin: 0 0 var(--space-2);
  }
  .card-actions {
    margin: var(--space-4) 0 0;
  }
  .tags {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-4) var(--space-5);
  }
  .tags p {
    margin: var(--space-2) 0 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-6) var(--space-5);
  }
  .label {
    display: block;
    font-family: var(--font-text);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .swatch {
    background: var(--white);
    border: var(--border) solid var(--line);
    box-shadow: var(--shadow-sm) var(--line);
    padding: var(--space-4);
  }
  .swatch > * {
    margin: 0;
  }
  .swatch > * + * {
    margin-top: var(--space-2);
  }
  .swatch > .chip + * {
    margin-top: var(--space-3);
  }
  .chip {
    height: 5rem;
    border: var(--border-thin) solid var(--line);
  }
  .pair {
    font-weight: 700;
  }

  .box {
    background: var(--white);
    border: var(--border) solid var(--line);
    padding: var(--space-5) var(--space-4);
  }
  .box.thin {
    border: var(--border-thin) solid var(--line);
  }
  .box.pill {
    border-radius: var(--radius-tag);
    text-align: center;
  }

  .font-sample {
    font-size: var(--step-2);
    line-height: 1.25;
  }
  .font-sample.display {
    font-family: var(--font-display);
    font-weight: 800;
  }

  .stack {
    display: grid;
    gap: var(--space-4);
  }
  .step {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.1;
  }
  .space {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .space code {
    min-width: 7rem;
  }
  .bar {
    height: var(--space-5);
    background: var(--orange);
    border: var(--border-thin) solid var(--line);
  }
</style>
