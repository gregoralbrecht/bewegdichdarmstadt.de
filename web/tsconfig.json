{
  "extends": "astro/tsconfigs/strict",
  // Astro's include skips dot folders, so .storybook is added by hand.
  "include": [".astro/types.d.ts", "**/*", ".storybook/**/*"],
  "exclude": ["dist", "storybook-static"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
